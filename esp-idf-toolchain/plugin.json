        "properties": {
          "port": {
            "type": "string",
            "description": "可选，缺省用选中串口"
          }
        }
      },
      "transport": "cli",
      "projectTypes": [
        "esp-idf"
      ],
      "category": "execute",
      "cli": {
        "command": [
          "{settings.toolchain.active.pythonExe}",
          "{settings.toolchain.active.path}/tools/idf.py",
          "-p",
          "{defaultPort}",
          "flash"
        ],
        "cwd": "{projectPath}",
        "env": {
          "IDF_PATH": "{settings.toolchain.active.path}",
          "IDF_TOOLS_PATH": "{settings.toolchain.active.toolsPath}",
          "IDF_PYTHON_ENV_PATH": "{settings.toolchain.active.pythonEnvPath}",
          "PATH": "{settings.toolchain.active.exportPath};{settings.toolchain.active.pythonEnvPath}/Scripts;{env.PATH}"
        },
        "timeoutMs": 600000,
        "maxOutput": 12000,
        "stream": true,
        "streamChannel": "compile:onOutput",
        "pauseSerialPort": true
      }
    },
    {
      "name": "set_target",
      "description": "设置目标芯片并重新配置项目（esp32/esp32s2/esp32s3/esp32c2/esp32c3/esp32c6/esp32h2/esp32p4/esp32c5/esp32c61）。",
