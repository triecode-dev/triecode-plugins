{
  "id": "espressif-idf-toolchain",
  "name": "ESP-IDF 工具链",
  "version": "0.1.11",
  "description": "ESP-IDF 嵌入式工具链：图形化 Kconfig 配置、编译/烧录/目标芯片、串口日志、AI 工具。检测复用本机已装 ESP-IDF（可一键下载官方安装器）。",
  "developer": "TrieCode",
  "icon": "espressif",
  "category": "嵌入式工具链",
  "capabilities": {
    "compile": {
      "transport": "cli",
      "command": [
        "{settings.toolchain.active.pythonExe}",
        "{settings.toolchain.active.path}/tools/idf.py",
        "build"
      ],
      "cwd": "{projectPath}",
      "env": {
        "IDF_PATH": "{settings.toolchain.active.path}",
        "IDF_TOOLS_PATH": "{settings.toolchain.active.toolsPath}",
        "IDF_PYTHON_ENV_PATH": "{settings.toolchain.active.pythonEnvPath}",
        "PATH": "{settings.toolchain.active.exportPath};{settings.toolchain.active.pythonEnvPath}/Scripts;{env.PATH}"
      },
      "stream": true,
      "streamChannel": "compile:onOutput",
      "timeoutMs": 600000,
      "maxOutput": 12000
    },
    "upload": {
      "transport": "cli",
      "command": [
        "{settings.toolchain.active.pythonExe}",
        "{settings.toolchain.active.path}/tools/idf.py",
        "-p",
        "{defaultPort}",
        "flash"
      ],
      "cwd": "{projectPath}",
      "env": {
        "IDF_PATH": "{settings.toolchain.active.path}",
        "IDF_TOOLS_PATH": "{settings.toolchain.active.toolsPath}",
        "IDF_PYTHON_ENV_PATH": "{settings.toolchain.active.pythonEnvPath}",
        "PATH": "{settings.toolchain.active.exportPath};{settings.toolchain.active.pythonEnvPath}/Scripts;{env.PATH}"
      },
      "stream": true,
      "streamChannel": "compile:onOutput",
      "pauseSerialPort": true,
      "timeoutMs": 600000,
      "maxOutput": 12000
    },
    "flash": {
      "transport": "cli",
      "command": [
        "{settings.toolchain.active.pythonExe}",
        "{settings.toolchain.active.path}/tools/idf.py",
        "-p",
        "{defaultPort}",
        "flash"
      ],
      "cwd": "{projectPath}",
      "env": {
        "IDF_PATH": "{settings.toolchain.active.path}",
        "IDF_TOOLS_PATH": "{settings.toolchain.active.toolsPath}",
        "IDF_PYTHON_ENV_PATH": "{settings.toolchain.active.pythonEnvPath}",
        "PATH": "{settings.toolchain.active.exportPath};{settings.toolchain.active.pythonEnvPath}/Scripts;{env.PATH}"
      },
      "stream": true,
      "streamChannel": "compile:onOutput",
      "pauseSerialPort": true,
      "timeoutMs": 600000,
      "maxOutput": 12000
    },
    "board-select": {
      "transport": "cli",
      "command": [
        "{settings.toolchain.active.pythonExe}",
        "{settings.toolchain.active.path}/tools/idf.py",
        "set-target",
        "{target}"
      ],
      "cwd": "{projectPath}",
      "env": {
        "IDF_PATH": "{settings.toolchain.active.path}",
        "IDF_TOOLS_PATH": "{settings.toolchain.active.toolsPath}",
        "IDF_PYTHON_ENV_PATH": "{settings.toolchain.active.pythonEnvPath}",
        "PATH": "{settings.toolchain.active.exportPath};{settings.toolchain.active.pythonEnvPath}/Scripts;{env.PATH}"
      },
      "timeoutMs": 300000
    },
    "board-manage": {
      "transport": "cli",
      "command": [
        "{settings.toolchain.active.pythonExe}",
        "{settings.toolchain.active.path}/tools/idf.py",
        "--list-targets"
      ],
      "cwd": "{projectPath}",
      "env": {
        "IDF_PATH": "{settings.toolchain.active.path}",
        "IDF_TOOLS_PATH": "{settings.toolchain.active.toolsPath}",
        "IDF_PYTHON_ENV_PATH": "{settings.toolchain.active.pythonEnvPath}",
        "PATH": "{settings.toolchain.active.exportPath};{settings.toolchain.active.pythonEnvPath}/Scripts;{env.PATH}"
      },
      "timeoutMs": 60000
    }
  },
  "detection": {
    "envVars": [
      "IDF_PATH"
    ],
    "installerJson": {
      "paths": [
        "$USERPROFILE/.espressif/idf-env.json",
        "~/.espressif/idf-env.json",
        "C:/Espressif/idf-env.json",
        "D:/Espressif/idf-env.json"
      ],
      "selectedKey": "idfSelectedId",
      "entriesKey": "idfInstalled",
      "pathField": "path",
      "pythonField": "python",
      "toolsPathField": "espressif.idfToolsPath"
    },
    "pathGlobs": [
      "<toolsPath>/frameworks/esp-idf-v*",
      "C:/Espressif/frameworks/esp-idf-v*",
      "D:/Espressif/frameworks/esp-idf-v*",
      "$USERPROFILE/esp",
      "~/.espressif",
      "C:/esp-idf"
    ],
    "validateFile": "tools/idf.py",
    "derive": {
      "toolsPath": "parent(frameworks)",
      "pythonEnv": "glob(python_env/idf*_py*_env)",
      "exportPathFrom": "tools/tools.json"
    }
  },
  "installer": {
    "url": "https://dl.espressif.cn/dl/idf-installer/esp-idf-tools-setup-online-2.4.1.exe",
    "fileName": "idf-installer.exe"
  },
  "projectDetection": {
    "markers": [
      {
        "file": "CMakeLists.txt",
        "contains": "project.cmake"
      }
    ],
    "type": "esp-idf"
  },
  "backends": [
    {
      "id": "confserver",
      "type": "stdio",
      "rpc": "kconfig",
      "command": "{settings.toolchain.active.pythonExe}",
      "args": [
        "{settings.toolchain.active.path}/tools/idf.py",
        "confserver"
      ],
      "cwd": "{projectPath}",
      "env": {
        "IDF_PATH": "{settings.toolchain.active.path}",
        "IDF_TOOLS_PATH": "{settings.toolchain.active.toolsPath}",
        "IDF_PYTHON_ENV_PATH": "{settings.toolchain.active.pythonEnvPath}",
        "PATH": "{settings.toolchain.active.exportPath};{settings.toolchain.active.pythonEnvPath}/Scripts;{env.PATH}"
      }
    }
  ],
  "devicePanel": {
    "id": "esp-idf-device",
    "title": "ESP-IDF 设备",
    "selectors": [
      {
        "id": "target",
        "title": "目标芯片",
        "source": {
          "transport": "cli",
          "command": [
            "{settings.toolchain.active.pythonExe}",
            "{settings.toolchain.active.path}/tools/idf.py",
            "--list-targets"
          ],
          "cwd": "{projectPath}",
          "env": {
            "IDF_PATH": "{settings.toolchain.active.path}",
            "IDF_TOOLS_PATH": "{settings.toolchain.active.toolsPath}",
            "IDF_PYTHON_ENV_PATH": "{settings.toolchain.active.pythonEnvPath}",
            "PATH": "{settings.toolchain.active.exportPath};{settings.toolchain.active.pythonEnvPath}/Scripts;{env.PATH}"
          }
        },
        "searchable": true,
        "key": "target",
        "placeholder": "esp32 / s3 / c3 …",
        "onSelect": "set_target"
      },
      {
        "id": "port",
        "title": "串口",
        "source": {
          "transport": "internal",
          "service": "serialport",
          "method": "list"
        },
        "key": "port"
      }
    ],
    "actions": [
      {
        "id": "set_target",
        "title": "应用目标芯片",
        "icon": "cpu",
        "kind": "action",
        "placement": "device-panel.action",
        "hidden": true,
        "transport": "cli",
        "cli": {
          "command": [
            "{settings.toolchain.active.pythonExe}",
            "{settings.toolchain.active.path}/tools/idf.py",
            "set-target",
            "{target}"
          ],
          "cwd": "{projectPath}",
          "env": {
            "IDF_PATH": "{settings.toolchain.active.path}",
            "IDF_TOOLS_PATH": "{settings.toolchain.active.toolsPath}",
            "IDF_PYTHON_ENV_PATH": "{settings.toolchain.active.pythonEnvPath}",
            "PATH": "{settings.toolchain.active.exportPath};{settings.toolchain.active.pythonEnvPath}/Scripts;{env.PATH}"
          },
          "stream": true,
          "streamChannel": "compile:onOutput"
        }
      },
      {
        "id": "open_menuconfig",
        "title": "menuconfig 终端",
        "icon": "terminal",
        "kind": "action",
        "placement": "device-panel.action",
        "transport": "cli",
        "cli": {
          "command": [
            "{settings.toolchain.active.pythonExe}",
            "{settings.toolchain.active.path}/tools/idf.py",
            "menuconfig"
          ],
          "cwd": "{projectPath}",
          "env": {
            "IDF_PATH": "{settings.toolchain.active.path}",
            "IDF_TOOLS_PATH": "{settings.toolchain.active.toolsPath}",
            "IDF_PYTHON_ENV_PATH": "{settings.toolchain.active.pythonEnvPath}",
            "PATH": "{settings.toolchain.active.exportPath};{settings.toolchain.active.pythonEnvPath}/Scripts;{env.PATH}"
          },
          "pty": true
        }
      }
    ]
  },
  "views": [
    {
      "id": "status",
      "title": "目标与工具链",
      "icon": "espressif",
      "slot": "sidebar",
      "type": "webview",
      "entry": "ui/status.html",
      "events": [
        "toolchain:statusChanged"
      ]
    },
    {
      "id": "config",
      "title": "配置",
      "icon": "espressif",
      "slot": "sidebar",
      "type": "webview",
      "entry": "ui/config.html",
      "events": [
        "toolchain:statusChanged",
        "pluginSettings:espressif-idf-toolchain:changed"
      ]
    }
  ],
  "projectTypes": [
    {
      "id": "esp-idf",
      "title": "ESP-IDF 项目",
      "icon": "espressif",
      "description": "标准 ESP-IDF CMake 工程（app_main + Kconfig 配置）",
      "capabilities": [
        "compile",
        "upload",
        "flash",
        "board-select",
        "board-manage"
      ],
      "scaffold": [
        {
          "file": "CMakeLists.txt",
          "content": "cmake_minimum_required(VERSION 3.16)\ninclude($ENV{IDF_PATH}/tools/cmake/project.cmake)\nproject({name})\n"
        },
        {
          "file": "main/CMakeLists.txt",
          "content": "idf_component_register(SRCS \"main.c\" INCLUDE_DIRS \".\")\n"
        },
        {
          "file": "main/main.c",
          "content": "#include <stdio.h>\n#include \"freertos/FreeRTOS.h\"\n#include \"freertos/task.h\"\n#include \"esp_log.h\"\n\nstatic const char *TAG = \"{name}\";\n\nvoid app_main(void)\n{\n    ESP_LOGI(TAG, \"{name} 启动\");\n    while (1) {\n        vTaskDelay(pdMS_TO_TICKS(1000));\n    }\n}\n"
        },
        {
          "file": "sdkconfig.defaults",
          "content": "CONFIG_IDF_TARGET=\"esp32\"\n"
        },
        {
          "file": ".gitignore",
          "content": "build/\nsdkconfig\nsdkconfig.old\n"
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "build",
      "description": "编译当前 ESP-IDF 项目（idf.py build）。",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "transport": "cli",
      "projectTypes": [
        "esp-idf"
      ],
      "category": "execute",
      "cli": {
        "command": [
          "{settings.toolchain.active.pythonExe}",
          "{settings.toolchain.active.path}/tools/idf.py",
          "build"
        ],
        "cwd": "{projectPath}",
        "env": {
          "IDF_PATH": "{settings.toolchain.active.path}",
          "IDF_TOOLS_PATH": "{settings.toolchain.active.toolsPath}",
          "IDF_PYTHON_ENV_PATH": "{settings.toolchain.active.pythonEnvPath}",
          "PATH": "{settings.toolchain.active.exportPath};{settings.toolchain.active.pythonEnvPath}/Scripts;{env.PATH}"
        },
        "timeoutMs": 600000,
        "maxOutput": 12000,
        "stream": true,
        "streamChannel": "compile:onOutput"
      }
    },
    {
