{
  "id": "easyeda-toolchain",
  "name": "立创EDA",
  "version": "0.2.0",
  "description": "把立创EDA(EasyEDA)接入 AI：工程/原理图/PCB/器件库/DRC 自动化设计。桥进程由本插件托管，EDA 侧需安装随包分发的 triecode-easyeda-gateway 扩展。需配合最新版软件（含 {nodeBin} 统一 Node 运行时）。",
  "developer": "TrieCode",
  "icon": "easyeda",
  "category": "EDA 设计",
  "capabilities": [
    "mcp",
    "skills"
  ],
  "dependencies": [
    {
      "name": "node",
      "version": "22.14.0",
      "url": "https://registry.npmmirror.com/-/binary/node/v22.14.0/node-v22.14.0-win-x64.zip",
      "unzip": true
    }
  ],
  "mcpServers": [
    {
      "name": "easyeda",
      "command": "{nodeBin}",
      "args": [
        "{pluginDir}/server/dist/server.cjs",
        "--docs",
        "{pluginDir}/docs/index.json"
      ],
      "autoApprove": false
    }
  ],
  "tools": [
    {
      "name": "redesign",
      "description": "一键重新布局并接线（确定性，AI 只调一次）：主 IC 居中、电源(VCC)朝上/地(GND)朝下、信号流左到右、外围件贴对应引脚、器件间留布线通道，随后自动布全部网络（Steiner）。返回移动+布线+验证结果。核心省略自动选引脚最多的器件。",
      "parameters": {
        "type": "object",
        "properties": {
          "core": {
            "type": "string"
          },
          "wire": {
            "type": "boolean"
          },
          "apply": {
            "type": "boolean"
          }
        }
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_sch_redesign"
      },
      "category": "edit"
    },
    {
      "name": "status",
      "description": "桥与 EDA 连接状态：返回桥进程、已连接 EDA 窗口、活动窗口、端口（只读）。",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_status"
      },
      "category": "query"
    },
    {
      "name": "plan_layout",
      "description": "重排原理图元器件的第一步必用工具：AI 只表达意图（mode/anchors/groups/netFlags），引擎算坐标保证不重叠。最简调用 {mode:\"central-lr\", core:\"U1\", layout:{apply:true}} 即可自动摆好全部器件+网络标记；要贴脚加 anchors:[{s:\"C3\",p:\"1\",t:\"U1\",tp:\"RST\"}]。apply=true 直接落图并返回 violations。不要用 sch_modify 手写坐标摆放。",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "central-lr",
              "functional-zones",
              "rearrange"
            ],
            "description": "central-lr 单核心芯片左右外设；functional-zones 多模块功能分区；rearrange 原位微调"
          },
          "core": {
            "type": "string",
            "description": "核心芯片位号（central-lr 必需）"
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "s": {
                  "type": "string"
                },
                "p": {
                  "type": "string"
                },
                "t": {
                  "type": "string"
                },
                "tp": {
                  "type": "string"
                }
              }
            },
            "description": "贴脚约束"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "members": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "flow",
                    "pair",
                    "cluster"
                  ]
                },
                "direction": {
                  "type": "number"
                }
              }
            },
            "description": "功能块"
          },
          "netFlags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "net": {
                  "type": "string"
                },
                "dir": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down",
                    "left",
                    "right"
                  ]
                }
              }
            },
            "description": "网络标记方向意图"
          },
          "layout": {
            "type": "object",
            "properties": {
              "clearance": {
                "type": "number"
              },
              "spacing": {
                "type": "number"
              },
              "page": {
                "type": "string",
                "enum": [
                  "auto",
                  "keep"
                ]
              },
              "keepDesignators": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "apply": {
                "type": "boolean"
              }
            }
          }
        },
        "required": [
          "mode"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_sch_plan_layout"
      },
      "category": "edit"
    },
    {
      "name": "verify_layout",
      "description": "摆放/接线后必查：同尺校验布局（overlaps 器件重叠含5sch间距 / netflagsInsideParts 标记压件 / outOfSheet 越界），返回 ok 布尔。plan_layout 后调用确认无重叠。",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_sch_verify_layout"
      },
      "category": "query"
    },
    {
      "name": "list_windows",
      "description": "列出所有已连接 EDA 窗口及其状态（活动/工程/文档类型）。",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_list_windows"
      },
      "category": "query"
    },
    {
      "name": "select_window",
      "description": "当有多个 EDA 窗口时，指定后续操作使用哪个窗口。",
      "parameters": {
        "type": "object",
        "properties": {
          "windowId": {
            "type": "string",
            "description": "要设为活动的窗口 ID（来自 list_windows）"
          }
        },
        "required": [
          "windowId"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_select_window"
      },
      "category": "modify"
    },
    {
      "name": "execute",
      "description": "在立创EDA中执行任意JS（必须 return，console.log 不捕获）。可调全部官方 eda.* API。先 doc_search 查签名，注意坐标单位与 null 即失败。高风险任意代码，先确认意图。",
      "parameters": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "JS 代码主体"
          },
          "windowId": {
            "type": "string",
            "description": "可选：目标窗口 ID"
          },
          "timeoutMs": {
            "type": "number",
            "description": "可选：超时"
          }
        },
        "required": [
          "code"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_execute"
      },
      "category": "execute"
    },
    {
      "name": "doc_search",
      "description": "检索插件自带的立创EDA API 参考（类名/方法签名/枚举值）。写复杂 EDA 调用前先查正确签名。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "搜索关键词（英文类名/方法名最佳）"
          },
          "maxResults": {
            "type": "number",
            "description": "可选：返回条数（默认 8）"
          }
        },
        "required": [
          "query"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_doc_search"
      },
      "category": "query"
    },
    {
      "name": "convert",
      "description": "立创EDA 坐标单位换算（PCB=mil / 原理图=0.01inch / mm）。放件前换算避免 10 倍错位。",
      "parameters": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "from": {
            "type": "string",
            "enum": [
              "mm",
              "mil",
              "sch"
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "mm",
              "mil",
              "sch"
            ]
          }
        },
        "required": [
          "value",
          "from",
          "to"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_convert"
      },
      "category": "query"
    },
    {
      "name": "project_info",
      "description": "返回当前打开的立创EDA 工程与文档信息（只读）。PCB 操作需先有工程且激活 PCB 文档。",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_project_info"
      },
      "category": "query"
    },
    {
      "name": "project_list",
      "description": "遍历团队/文件夹列出可打开工程（最多 50 个）。openProject 可能丢弃未保存修改，打开前提示用户保存。",
      "parameters": {
        "type": "object",
        "properties": {
          "maxItems": {
            "type": "number",
            "description": "可选：条数上限"
          }
        }
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_project_list"
      },
      "category": "query"
    },
    {
      "name": "project_open",
      "description": "按 UUID 打开立创EDA 工程。注意：可能丢弃当前工程未保存修改，请先询问用户确认保存。",
      "parameters": {
        "type": "object",
        "properties": {
          "projectUuid": {
            "type": "string",
            "description": "目标工程 UUID（来自 project_list）"
          }
        },
        "required": [
          "projectUuid"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_project_open"
      },
      "category": "modify"
    },
    {
      "name": "project_create",
      "description": "新建空白工程并返回 UUID。",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_project_create"
      },
      "category": "modify"
    },
    {
      "name": "document_state",
      "description": "检查当前激活文档类型（原理图/PCB/封装等）与工程是否打开。执行 PCB/SCH 操作前先调用。",
      "parameters": {
        "type": "object",
        "properties": {
          "want": {
            "type": "string",
            "enum": [
              "PCB",
              "SCHEMATIC_PAGE",
              "FOOTPRINT",
              "SYMBOL_COMPONENT",
              "PANEL"
            ],
            "description": "可选：期望文档类型"
          }
        }
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_document_state"
      },
      "category": "query"
    },
    {
      "name": "doc_open",
      "description": "按文档 uuid 打开并激活（原理图页/PCB/封装等），自动轮询确认激活成功，返回 tabId 与文档类型。",
      "parameters": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "要打开的文档 uuid（来自 project_info/document_state/sch_list 等）"
          }
        },
        "required": [
          "uuid"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_doc_open"
      },
      "category": "modify"
    },
    {
      "name": "document_save",
      "description": "保存当前激活的 PCB/原理图文档。",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_document_save"
      },
      "category": "modify"
    },
    {
      "name": "lib_search",
      "description": "在立创EDA 器件库按关键词搜索器件（返回 name/uuid/libraryUuid/封装名）。放件前先搜索拿器件 UUID。",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "搜索关键词（如 STM32F103 / 10k 0603）"
          },
          "libraryUuid": {
            "type": "string",
            "description": "可选：限定库"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number",
            "description": "可选：每页条数（默认 8，最大 20）"
          }
        },
        "required": [
          "keyword"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_lib_search"
      },
      "category": "query"
    },
    {
      "name": "lib_get_by_lcsc",
      "description": "按立创商城 LCSC 编号（C 开头，如 C14663）查器件，返回 uuid/封装。",
      "parameters": {
        "type": "object",
        "properties": {
          "lcsc": {
            "type": "string"
          },
          "allowMultiMatch": {
            "type": "boolean"
          }
        },
        "required": [
          "lcsc"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_lib_get_by_lcsc"
      },
      "category": "query"
    },
    {
      "name": "lib_search_symbol",
      "description": "在符号库搜索符号。",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string"
          },
          "libraryUuid": {
            "type": "string"
          },
          "pageSize": {
            "type": "number"
          }
        },
        "required": [
          "keyword"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_lib_search_symbol"
      },
      "category": "query"
    },
    {
      "name": "lib_search_footprint",
      "description": "在封装库搜索封装。",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string"
          },
          "libraryUuid": {
            "type": "string"
          },
          "pageSize": {
            "type": "number"
          }
        },
        "required": [
          "keyword"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_lib_search_footprint"
      },
      "category": "query"
    },
    {
      "name": "sch_list",
      "description": "列出当前原理图全部器件，含每个器件的包围盒 bbox（尺寸，sch 单位）与重叠器件对列表。放置/移动后务必调用它检查是否重叠。",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_sch_list"
      },
      "category": "query"
    },
    {
      "name": "sch_place_component",
      "description": "在原理图坐标 (x,y) 放置器件，返回新器件的 bbox（尺寸）与引脚坐标（供布线直接用）。旋转默认 0（正立），保持器件方向除非布局明确需要。坐标默认 mm，可传 unit=sch。",
      "parameters": {
        "type": "object",
        "properties": {
          "deviceUuid": {
            "type": "string"
          },
          "libraryUuid": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "description": "X 坐标（单位见 unit，默认 mm）"
          },
          "y": {
            "type": "number",
            "description": "Y 坐标（单位见 unit，默认 mm）"
          },
          "unit": {
            "type": "string",
            "enum": [
              "mm",
              "sch"
            ],
            "description": "坐标单位（默认 mm）"
          },
          "rotation": {
            "type": "number"
          },
          "mirror": {
            "type": "boolean"
          }
        },
        "required": [
          "deviceUuid",
          "libraryUuid",
          "x",
          "y"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_sch_place_component"
      },
      "category": "modify"
    },
    {
      "name": "sch_modify",
      "description": "按 primitiveId 移动/旋转/改位号原理图元件，也能移动 VCC/GND 等网络标记（async 图元模式）。返回新坐标+bbox+引脚。坐标默认 mm，可传 unit=sch。",
      "parameters": {
        "type": "object",
        "properties": {
          "primitiveId": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "enum": [
              "mm",
              "sch"
            ]
          },
          "rotation": {
            "type": "number"
          },
          "designator": {
            "type": "string"
          }
        },
        "required": [
          "primitiveId"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_sch_modify"
      },
      "category": "modify"
    },
    {
      "name": "sch_add_net_flag",
      "description": "在原理图坐标处添加电源/地网络标记（net flag）。identification 仅支持 Power/Ground/AnalogGround/ProtectGround；net 是网络名（如 VCC/3V3/GND）。返回标记坐标。",
      "parameters": {
        "type": "object",
        "properties": {
          "identification": {
            "type": "string",
            "enum": [
              "Power",
              "Ground",
              "AnalogGround",
              "ProtectGround"
            ]
          },
          "net": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "description": "X 坐标（mm）"
          },
          "y": {
            "type": "number",
            "description": "Y 坐标（mm）"
          }
        },
        "required": [
          "identification",
          "net",
          "x",
          "y"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_sch_add_net_flag"
      },
      "category": "modify"
    },
    {
      "name": "sch_get_pins",
      "description": "按器件 id 读取全部引脚的精确坐标（sch 单位）。布线前先调用，避免端点连错。",
      "parameters": {
        "type": "object",
        "properties": {
          "primitiveId": {
            "type": "string"
          }
        },
        "required": [
          "primitiveId"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_sch_get_pins"
      },
      "category": "query"
    },
    {
      "name": "sch_wire",
      "description": "按折线端点画导线（可带网络名）。坐标默认 mm，可传 unit=sch。端点用 sch_get_pins 读精确引脚坐标，否则连不上。",
      "parameters": {
        "type": "object",
        "properties": {
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "net": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "enum": [
              "mm",
              "sch"
            ]
          }
        },
        "required": [
          "points"
        ]
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_sch_wire"
      },
      "category": "modify"
    },
    {
      "name": "wire_delete",
      "description": "删除原理图全部导线（或按 net 只删指定网络）。⚠️ 立创导线没有 .id 属性，必须用 getState_PrimitiveId() 取 id（手写 w.id 会静默失败）。重排前先删旧线。",
      "parameters": {
        "type": "object",
        "properties": {
          "net": {
            "type": "string"
          }
        }
      },
      "transport": "mcp",
      "mcp": {
        "server": "easyeda",
        "tool": "easyeda_sch_wire_delete"
      },
      "category": "edit"
    },
    {
      "name": "wire_net",
